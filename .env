# URL de la API vetChiloé (Express en Render, la misma de la Unidad I).
# Las variables EXPO_PUBLIC_ quedan dentro de la app: NUNCA pongas claves secretas aquí.
# Reemplaza por tu URL real, sin "/" al final. Después reinicia con: npx expo start -c
EXPO_PUBLIC_API_URL=https://vetchiloe.onrender.com

# Modo demostración de errores (déjalo vacío para usar la API real):
# servidor | sin-conexion | tiempo | vacio | lento
EXPO_PUBLIC_SIMULAR=
